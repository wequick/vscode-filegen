{
  "name": "filegen",
  "displayName": "Code File Generator",
  "description": "Create files in template. Generate C++ Class & UnitTest file with Google Style. Convert code to gmock.",
  "publisher": "Wequick",
  "icon": "icon/logo.png",
  "repository": {
    "url": "https://github.com/wequick/vscode-filegen.git"
  },
  "version": "1.1.2",
  "engines": {
    "vscode": "^1.41.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "generator",
    "c++",
    "class",
    "unittest",
    "file",
    "template",
    "google",
    "style",
    "gtest",
    "gmock"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "title": "FileGen",
        "command": "extension.filegen"
      },
      {
        "title": "Create C++ Class & UnitTest",
        "command": "extension.createClassAndUnitTest"
      },
      {
        "title": "Create C++ Class",
        "command": "extension.createClass"
      },
      {
        "title": "Create C++ UnitTest",
        "command": "extension.createUnitTest"
      },
      {
        "title": "FileGen: Replace to gmock class",
        "command": "extension.replaceGmock"
      },
      {
        "title": "FileGen: Extract gmock operator==",
        "command": "extension.extractGmockEq"
      },
      {
        "title": "FileGen: Extract gmock class",
        "command": "extension.extractGmockClass"
      },
      {
        "title": "Create Swift Class",
        "command": "extension.createSwiftClass"
      },
      {
        "title": "Create Objc Class (.h, .m)",
        "command": "extension.createObjcClass"
      },
      {
        "title": "Create Objcpp Class (.h, .mm)",
        "command": "extension.createObjcppClass"
      },
      {
        "title": "Create Group",
        "command": "extension.createXcodeGroup"
      },
      {
        "title": "Delete",
        "command": "extension.deleteXcodeFile"
      }
    ],
    "submenus": [
      {
        "id": "file/filegen",
        "label": "FileGen"
      },
      {
        "id": "file/filegen/cpp",
        "label": "FileGen: C++"
      },
      {
        "id": "file/filegen/xcode",
        "label": "FileGen: Xcode"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "group": "navigation@-2",
          "submenu": "file/filegen/cpp"
        },
        {
          "group": "navigation@-1",
          "submenu": "file/filegen/xcode"
        }
      ],
      "file/filegen/cpp": [
        {
          "group": "file@0",
          "command": "extension.createClassAndUnitTest"
        },
        {
          "group": "file@1",
          "command": "extension.createClass"
        },
        {
          "group": "file@2",
          "command": "extension.createUnitTest"
        }
      ],
      "file/filegen/xcode": [
        {
          "group": "group0@item0",
          "command": "extension.createSwiftClass"
        },
        {
          "group": "group0@item1",
          "command": "extension.createObjcClass"
        },
        {
          "group": "group0@item2",
          "command": "extension.createObjcppClass"
        },
        {
          "group": "group1@item0",
          "command": "extension.createXcodeGroup"
        },
        {
          "group": "group2@item0",
          "command": "extension.deleteXcodeFile"
        }
      ],
      "editor/context": [
        {
          "group": "0_extension_group",
          "when": "editorHasSelection",
          "command": "extension.replaceGmock"
        },
        {
          "group": "0_extension_group",
          "command": "extension.extractGmockClass"
        },
        {
          "group": "0_extension_group",
          "command": "extension.extractGmockEq"
        }
      ]
    },
    "keybindings": [
      {
        "command": "extension.createClassAndUnitTest",
        "key": "alt+x",
        "when": "editorTextFocus"
      }
    ],
    "languages": [
      {
        "id": "cpp",
        "extensions": [
          ".cpp",
          ".hpp"
        ]
      }
    ],
    "configuration": [
      {
        "title": "File Generator",
        "properties": {
          "filegen.templatePath": {
            "type": "string",
            "default": "filegen",
            "description": "Specifies the path, where the template files located in."
          },
          "filegen.gmockStyle": {
            "type": "string",
            "enum": [
              "old",
              "new"
            ],
            "enumDescriptions": [
              "Use the old-style MOCK_METHODn, MOCK_CONST_METHODn, ... macros.",
              "Use the new MOCK_METHOD macro."
            ],
            "default": "old",
            "description": "Gmock style to use when generating mock classes from interfaces."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "release": "node scripts/release.js",
    "package": "node scripts/package.js"
  },
  "devDependencies": {
    "@types/glob": "^7.1.1",
    "@types/mocha": "^5.2.7",
    "@types/node": "^12.12.22",
    "@types/vscode": "^1.41.0",
    "glob": "^7.1.5",
    "mocha": "^6.2.2",
    "tslint": "^5.20.0",
    "typescript": "^3.6.4",
    "vscode-test": "^1.2.2"
  }
}
